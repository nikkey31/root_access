[gd_scene format=3]

[ext_resource type="Theme" path="res://assets/theme/retro_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/ending_screen.gd" id="2_script"]

[node name="EndingScreen" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_script")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.06, 0.88)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -340.0
offset_top = -230.0
offset_right = 340.0
offset_bottom = 230.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="VBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="BadgeLabel" type="Label" parent="Panel/Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.9, 0.46, 1)
theme_override_font_sizes/font_size = 12
text = "[ ДЕЛО ЗАКРЫТО: ЗАЛОЖНИЦА СПАСЕНА ]"

[node name="TitleLabel" type="Label" parent="Panel/Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 17
text = "КОНЦОВКА 1: ГЕРОЙ НОЧИ"

[node name="DateLabel" type="Label" parent="Panel/Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.72, 0.75, 1)
theme_override_font_sizes/font_size = 11
text = "02.10.2009 03:41 // ДЕТЕКТИВ: НИК БУДХАЙМ (NICK BUDHEIM)"

[node name="HSeparator" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="TextLabel" type="RichTextLabel" parent="Panel/Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 13
theme_override_font_sizes/bold_font_size = 13
bbcode_enabled = true
text = "03:41: Спецназ полиции штурмовал Склад № 3 в Северной промзоне..."

[node name="StatsLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.8, 0.85, 1)
theme_override_font_sizes/font_size = 11
text = "Итоговая оценка: ОТЛИЧНО"

[node name="HSeparator2" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 2

[node name="CloseButton" type="Button" parent="Panel/Margin/VBox/Buttons"]
custom_minimum_size = Vector2(170, 26)
layout_mode = 2
text = "Осмотреть рабочий стол"

[node name="RestartButton" type="Button" parent="Panel/Margin/VBox/Buttons"]
custom_minimum_size = Vector2(150, 26)
layout_mode = 2
text = "Начать заново"
