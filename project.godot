; Engine configuration file.
; Root Access — ретро-детектив на Godot 4.

config_version=5

[application]

config/name="Root Access"
config/description="Психологический детективный триллер в стилистике ретро-ОС."
run/main_scene="res://scenes/desktop/Desktop.tscn"
config/icon="res://assets/icons/root_access.svg"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/theme/retro_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0.501961, 0.501961, 1)
